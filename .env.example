# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the chat model (default: openai/gpt-oss-120b)
# Faster/cheaper alternatives on Groq: openai/gpt-oss-20b, qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Required when the frontend is deployed separately (e.g. on Vercel):
# ALLOWED_ORIGINS=https://repo-rag.vercel.app

# Optional: where Qdrant/SQLite/repo-registry data lives (default: ./data).     
# Point this at a mounted disk on Render so indexed repos and chats survive deploys.
# DATA_DIR=/var/data

# --- multi-user accounts (repo_rag/auth.py) ---
# Registration is open by default; set to 0 to freeze the user list.
# ALLOW_SIGNUP=1
# Session cookie: `secure` is auto (HTTPS-only on any non-localhost host).
# Set 0 only when serving the app over plain HTTP from a LAN IP.
# AUTH_COOKIE_SECURE=1
# Cookie SameSite policy (default lax). Only set `none` when the frontend is
# deployed on a DIFFERENT site (e.g. a Vercel app calling this backend) —
# otherwise the browser never keeps the session cookie. Same-origin setups
# (this backend serving frontend/dist) must keep lax.
# AUTH_COOKIE_SAMESITE=none
# Username that inherits the pre-auth repos/chats (legacy user 0) when it
# registers or signs in. Set this on a deployed instance to the exact account
# you use, so your existing index and chats stay visible after the upgrade.
# LEGACY_OWNER_NAME=sushant
